function collision()

	local x
	local y
	local z

	local mapWidth = 10
	local mapHeight = 10

	local map = {}

	-- cria o mapa
	for x = 1, mapWidth do

		map[x] = {}

		for y = 1, mapHeight do

			map[x][y] = {}

			for z = 1, mapWidth do

				map[x][y][z] = 0

			end
		end
	end

end
